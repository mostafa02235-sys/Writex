# Writex AI server configuration. Copy to .env (never commit .env) or set these
# as environment variables on your host. Only the server ever sees provider keys.

# --- server ---
PORT=8787
# Long random string used to sign device tokens (required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WRITEX_TOKEN_SECRET=
# Where the SQLite database lives (use a persistent disk on your host)
WRITEX_DB_PATH=./data/writex.db
# Extra web origins allowed to call the API (comma separated). The Android/iOS app
# origins (https://localhost, capacitor://localhost) are always allowed.
WRITEX_ALLOWED_ORIGINS=

# --- model providers: set at least one ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# Self-hosted open-source models through any OpenAI-compatible server
# (Ollama: http://localhost:11434/v1, vLLM, LM Studio, llama.cpp server…)
SELFHOSTED_BASE_URL=
SELFHOSTED_API_KEY=

# --- model routing ---
# provider:model for each tier. "fast" handles short tasks, "smart" handles long or
# demanding tasks, "vision" handles images. Leave empty to use the defaults of the
# first configured provider (see docs/AI_BACKEND.md).
WRITEX_MODEL_FAST=
WRITEX_MODEL_SMART=
WRITEX_MODEL_VISION=

# --- limits ---
WRITEX_MAX_CONCURRENT_JOBS=4          # jobs running at once on this server
WRITEX_DEVICE_CONCURRENT_JOBS=2       # per device
WRITEX_DEVICE_JOBS_PER_MINUTE=12
WRITEX_DEVICE_DAILY_CHARS=3000000     # characters sent to models per device per day
WRITEX_REGISTRATIONS_PER_HOUR=20      # new devices per IP per hour
WRITEX_JOB_TIMEOUT_SECONDS=900
WRITEX_REQUEST_TIMEOUT_SECONDS=180
WRITEX_MAX_UPLOAD_MB=25
# Optional: require this key (sent by the app as X-Writex-Invite) to register devices,
# for a private beta. Leave empty for open registration.
WRITEX_INVITE_CODE=

# Never enable in production: a deterministic stand-in model used only by automated tests.
WRITEX_ENABLE_TEST_PROVIDER=0
