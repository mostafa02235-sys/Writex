<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme: true AMOLED black, light system-bar icons -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/writex_black</item>
        <item name="colorPrimaryDark">@color/writex_black</item>
        <item name="colorAccent">@color/writex_accent</item>
        <item name="android:windowBackground">@color/writex_black</item>
        <item name="android:statusBarColor">@color/writex_black</item>
        <item name="android:navigationBarColor">@color/writex_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Launch screen (Android 12+ splash API, back-ported by core-splashscreen) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/writex_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/writex_black</item>
        <item name="android:navigationBarColor">@color/writex_black</item>
    </style>
</resources>
