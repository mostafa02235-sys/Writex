{
  "name": "writex",
  "version": "1.0.0",
  "private": true,
  "description": "Writex — a mobile-first writing, reading, learning and document platform with full Arabic and English support.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:artifact": "node scripts/build.mjs --artifact",
    "i18n:check": "node scripts/i18n-check.mjs",
    "icons": "python3 scripts/make-icons.py",
    "android:apply": "node scripts/apply-android.mjs",
    "android:sync": "npm run build && npx cap sync android && node scripts/apply-android.mjs",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@fontsource/amiri": "^5.0.0",
    "@fontsource/cairo": "^5.0.0",
    "@fontsource/carlito": "^5.0.0",
    "@fontsource/courier-prime": "^5.0.0",
    "@fontsource/eb-garamond": "^5.0.0",
    "@fontsource/fraunces": "^5.0.0",
    "@fontsource/geist-sans": "^5.0.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.0.0",
    "@fontsource/lato": "^5.0.0",
    "@fontsource/lora": "^5.0.0",
    "@fontsource/merriweather": "^5.0.0",
    "@fontsource/noto-kufi-arabic": "^5.0.0",
    "@fontsource/noto-naskh-arabic": "^5.0.0",
    "@fontsource/open-sans": "^5.0.0",
    "@fontsource/roboto": "^5.0.0",
    "@fontsource/scheherazade-new": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "@fontsource/tajawal": "^5.0.0",
    "docx": "^9.5.1",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "lucide": "0.400.0",
    "mammoth": "1.8.0",
    "mathjax": "3.2.2",
    "pdfjs-dist": "3.11.174",
    "pptxgenjs": "3.12.0",
    "quill": "2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=20"
  }
}
